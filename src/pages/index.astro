---
import '../global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Centro Médico Saberes: Matronas en Concepción especializadas en salud integral femenina, anticoncepción, embarazo y más.">
    <title>Centro Médico Saberes - Matronas en Concepción</title>
  </head>
  <body class="bg-white text-slate-700 font-sans antialiased flex flex-col min-h-screen">
    
    <!-- HEADER -->
    <header class="flex justify-between items-center py-4 px-6 md:px-12 bg-white border-b border-slate-100 sticky top-0 z-50 shadow-sm">
      <div class="flex items-center gap-3">
        <img src="/logofinal.png" alt="Logo Saberes" class="h-10 w-auto" />
        <div class="hidden sm:block leading-tight">
          <h1 class="font-bold text-[#314832] text-lg">Saberes</h1>
        </div>
      </div>
      
      <nav class="hidden md:flex gap-8 text-sm font-bold text-[#314832] uppercase tracking-wide">
        <a href="#quienes-somos" class="hover:text-[#C19A6B] transition-colors">Quiénes Somos</a>
        <a href="#servicios" class="hover:text-[#C19A6B] transition-colors">Servicios</a>
        <a href="#convenios" class="hover:text-[#C19A6B] transition-colors">Convenios</a>
        <a href="#ubicacion" class="hover:text-[#C19A6B] transition-colors">Ubicación</a>
      </nav>

      <a href="https://wa.me/56954365775" target="_blank" class="bg-[#314832] text-white px-6 py-2 rounded-full font-bold shadow-sm hover:bg-[#233524] transition-colors text-sm">
        Agendar Cita
      </a>
    </header>

    <!-- HERO -->
    <main class="flex flex-col md:flex-row min-h-[75vh] bg-[#faf8f5]">
      <div class="w-full md:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center relative z-10">
        <h1 class="text-4xl md:text-6xl font-extrabold text-[#314832] mb-6 leading-tight">Tu Salud en Manos Profesionales y Empáticas.</h1>
        <p class="text-lg md:text-xl text-[#C19A6B] mb-10 font-bold">Centro Médico Saberes: Salud Integral para la Mujer en Concepción.</p>
        <a href="https://wa.me/56954365775" target="_blank" class="inline-flex bg-[#314832] text-white px-8 py-4 rounded-full font-bold shadow-lg hover:bg-[#233524] w-fit">Agendar por WhatsApp</a>
      </div>
      <div class="w-full md:w-1/2 flex items-center justify-center p-8">
        <img src="/foto-equipo.jpg" alt="Matronas" class="w-full h-auto object-cover rounded-[2rem] shadow-2xl max-h-[600px]" loading="lazy" />
      </div>
    </main>

    <!-- QUIÉNES SOMOS -->
    <section id="quienes-somos" class="py-20 bg-[#314832] text-[#faf8f5] px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-sm font-bold text-[#C19A6B] tracking-widest uppercase mb-2">Conócenos</h2>
        <h3 class="text-4xl font-extrabold text-white mb-8">Quiénes Somos</h3>
        <p class="text-lg leading-relaxed mb-6">En Saberes, buscamos caminar a tu lado en cada etapa, brindando salud con empatía.</p>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="py-20 bg-[#faf8f5] px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-extrabold text-center text-[#314832] mb-12">Nuestros Servicios</h2>
        <div class="flex flex-wrap justify-center gap-6">
          {[
            { titulo: "Atención Clínica", items: ["Control Ginecológico Anual: $5.700", "Control Prenatal: $5.700", "Asesoría Anticonceptiva: $5.700"] },
            { titulo: "Telemedicina", items: ["Atención Online: $10.000", "Consejería Lactancia (Box): $35.000", "Consejería Lactancia (Domicilio): $45.000"] },
            { titulo: "Muestras", items: ["PAP (con lab): $17.000", "VPH (con lab): $75.000", "Panel ITS: $62.000 (con lab)"] },
            { titulo: "Anticonceptivos", items: ["Sayana Press: $22.000", "Mesigyna: $12.000", "Inyección simple: $5.000"] },
            { titulo: "Dispositivos", items: ["T de Cobre: Inserción $55.000", "Implanon (Ins/Rec): $110k - $135k", "Asertia: $120k - $140k"] },
            { titulo: "Estética", items: ["Plasmapen (Lesiones): $40.000 base"] }
          ].map((s) => (
            <div class="w-full sm:w-[48%] lg:w-[31%] bg-white p-8 rounded-3xl shadow-sm border border-slate-100 flex flex-col">
              <h3 class="text-xl font-bold text-[#314832] mb-4">{s.titulo}</h3>
              <ul class="space-y-2 text-sm text-slate-600">
                {s.items.map(i => <li class="flex items-start gap-2">✓ {i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONVENIOS -->
    <section id="convenios" class="py-16 bg-[#314832] px-6">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-sm font-bold text-[#C19A6B] uppercase tracking-[0.2em] mb-10">Convenios y Alianzas</h2>
        <div class="flex flex-wrap justify-center gap-10">
          <img src="/logo-fonasa.png" alt="Fonasa" class="h-12 grayscale hover:grayscale-0 opacity-80 transition" />
          <img src="/logo-cpd.png" alt="CPD" class="h-12 grayscale hover:grayscale-0 opacity-80 transition" />
          <img src="/logo-lab-koch.png" alt="Lab Koch" class="h-12 grayscale hover:grayscale-0 opacity-80 transition" />
          <img src="/logo-indimed.png" alt="Indimed" class="h-12 grayscale hover:grayscale-0 opacity-80 transition" />
        </div>
      </div>
    </section>

    <!-- EDUCACIÓN -->
    <section class="py-20 bg-[#faf8f5] px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-xl font-bold text-[#314832] mb-6">Artículos de Interés</h3>
          <a href="https://lavidamoderna.cl/2026/estigma-menstrual/" class="block bg-white p-6 rounded-2xl mb-4 hover:shadow-md">Estigma menstrual</a>
          <a href="https://lavidamoderna.cl/2026/un-miedo-viral-vph/" class="block bg-white p-6 rounded-2xl hover:shadow-md">La verdad sobre el VPH</a>
        </div>
        <div class="bg-[#314832] p-8 rounded-3xl text-white">
          <h3 class="text-xl font-bold mb-4">Podcast: Detrás del Biombo</h3>
          <p class="mb-6 opacity-80">Conversaciones expertas sobre salud femenina.</p>
          <a href="https://www.youtube.com/@Detr%C3%A1sdelbiombo/videos" class="bg-[#C19A6B] px-6 py-3 rounded-full font-bold">Ver en YouTube</a>
        </div>
      </div>
    </section>

    <!-- SECCIÓN DE DIVULGACIÓN (Artículos y Podcast) -->
    <section class="py-20 bg-[#faf8f5] px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-extrabold text-[#314832] text-center mb-16">Educación y Divulgación</h2>
        
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Artículos -->
          <div class="space-y-6">
            <h3 class="text-xl font-bold text-[#314832] border-l-4 border-[#C19A6B] pl-4">En la Prensa</h3>
            <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition">
              <h4 class="font-bold text-[#314832]">Estigma menstrual: Rompiendo tabúes</h4>
              <p class="text-sm text-slate-600 mt-2 mb-4">La importancia de normalizar los procesos naturales y desmitificar la salud menstrual.</p>
              <a href="https://lavidamoderna.cl/2026/estigma-menstrual/" target="_blank" class="text-[#C19A6B] font-bold text-sm hover:underline">Leer artículo →</a>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition">
              <h4 class="font-bold text-[#314832]">Un miedo viral: La verdad sobre el VPH</h4>
              <p class="text-sm text-slate-600 mt-2 mb-4">Despejamos dudas sobre el virus del papiloma humano para que el miedo no gane terreno.</p>
              <a href="https://lavidamoderna.cl/2026/un-miedo-viral-vph/" target="_blank" class="text-[#C19A6B] font-bold text-sm hover:underline">Leer artículo →</a>
            </div>
          </div>

          <!-- Podcast -->
          <div class="bg-[#314832] p-8 rounded-3xl text-white flex flex-col justify-center shadow-xl">
            <h3 class="text-xl font-bold mb-4 border-l-4 border-[#C19A6B] pl-4">Detrás del Biombo</h3>
            <p class="text-[#e8dccb] mb-6 leading-relaxed">Escucha nuestro podcast donde exploramos temas de salud femenina de manera cercana, humana y experta.</p>
            <a href="https://www.youtube.com/@Detr%C3%A1sdelbiombo/videos" target="_blank" class="inline-flex items-center gap-2 bg-[#C19A6B] text-white px-6 py-3 rounded-full font-bold hover:bg-[#a38058] transition w-fit">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.377.505 9.377.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              Ver en YouTube
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- UBICACIÓN Y CONTACTO -->
    <section id="ubicacion" class="py-20 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
        <div class="h-96 rounded-2xl overflow-hidden"><iframe src="https://www.google.com/maps/embed?..." width="100%" height="100%" loading="lazy"></iframe></div>
        <div>
          <h2 class="text-3xl font-extrabold text-[#314832] mb-6">Hablemos</h2>
          <p>O'Higgins Poniente 77, Concepción.</p>
          <a href="https://wa.me/56954365775" class="mt-6 inline-block bg-[#314832] text-white px-8 py-4 rounded-full font-bold">Agendar por WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#233524] py-10 text-center text-[#e8dccb]">
      <p>© 2026 Centro Médico Saberes.</p>
      <div class="mt-4 text-xs space-x-4">
        <a href="/privacidad" class="hover:underline">Privacidad</a>
        <a href="/terminos" class="hover:underline">Términos y Condiciones</a>
      </div>
    </footer>
  </body>
</html>