        <a href="#convenios" class="hover:text-[#C19A6B] transition-colors">Convenios</a>
        <a href="#educacion" class="hover:text-[#C19A6B] transition-colors">Educación</a>
        <a href="#ubicacion" class="hover:text-[#C19A6B] transition-colors">Ubicación</a>
      </nav>

      <!-- Botón Superior -->
      <a 
        href="https://wa.me/56954365775?text=Hola,%20vengo%20desde%20la%20página%20web%20y%20me%20gustaría%20agendar%20una%20cita." 
        target="_blank"
        class="bg-[#314832] text-white px-6 py-2 rounded-full font-bold shadow-sm hover:bg-[#233524] transition-colors text-sm"
      >
        Agendar Cita
