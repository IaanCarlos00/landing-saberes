---
import '../global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Centro Médico Saberes - Matronas en Concepción</title>
  </head>
  <body class="bg-white text-slate-700 font-sans antialiased flex flex-col min-h-screen">
    
    <!-- HEADER / BARRA DE NAVEGACIÓN -->
    <header class="flex justify-between items-center py-4 px-6 md:px-12 bg-white border-b border-slate-100 sticky top-0 z-50 shadow-sm">
      <div class="flex items-center gap-3">
        <img src="/logofinal.png" alt="Logo Saberes" class="h-10 w-auto" />
        <div class="hidden sm:block leading-tight">
          <h1 class="font-bold text-[#314832] text-lg">Saberes</h1>
        </div>
      </div>
      
      <nav class="hidden md:flex gap-8 text-sm font-bold text-[#314832] uppercase tracking-wide">
        <a href="#quienes-somos" class="hover:text-[#C19A6B] transition-colors">Quiénes Somos</a>
        <a href="#servicios" class="hover:text-[#C19A6B] transition-colors">Servicios</a>
        <a href="#ubicacion" class="hover:text-[#C19A6B] transition-colors">Ubicación</a>
      </nav>

      <!-- Botón Superior -->
      <a 
        href="https://wa.me/56954365775?text=Hola,%20vengo%20desde%20la%20página%20web%20y%20me%20gustaría%20agendar%20una%20cita." 
        target="_blank"
        class="bg-[#314832] text-white px-6 py-2 rounded-full font-bold shadow-sm hover:bg-[#233524] transition-colors text-sm"
      >
        Agendar Cita
      </a>
    </header>

    <!-- HERO SECTION -->
    <main class="flex flex-col md:flex-row min-h-[75vh] bg-[#faf8f5]">
      <div class="w-full md:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center relative z-10">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-[#314832] mb-6 tracking-tight leading-tight">
          Tu Salud y Bienestar en Manos Profesionales y Empáticas.
        </h1>
        <p class="text-lg md:text-xl text-[#C19A6B] mb-10 font-bold">
          Centro Médico Saberes: Espacio de Salud Integral para la Mujer en Concepción.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
          <a 
            href="https://wa.me/56954365775?text=Hola,%20vengo%20desde%20la%20página%20web%20y%20me%20gustaría%20agendar%20una%20cita." 
            target="_blank" 
            class="inline-flex bg-[#314832] text-white px-8 py-4 rounded-full font-bold shadow-lg hover:bg-[#233524] transition-all gap-3 items-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C19A6B]" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"></path></svg>
            Agendar por WhatsApp
          </a>
        </div>
      </div>

      <!-- Foto de equipo general o de ambiente -->
      <div class="w-full md:w-1/2 flex items-center justify-center p-8 lg:p-16">
        <img src="/foto-equipo.jpg" alt="Matronas Javiera y Valentina" class="w-full h-auto object-cover rounded-[2rem] shadow-2xl border-4 border-white aspect-square md:aspect-auto md:h-full max-h-[600px]" />
      </div>
    </main>

    <!-- SECCIÓN QUIÉNES SOMOS Y EQUIPO -->
    <section id="quienes-somos" class="py-20 bg-[#314832] px-6 text-[#faf8f5]">
      <div class="max-w-6xl mx-auto">
        
        <!-- Texto de Introducción -->
        <div class="max-w-4xl mx-auto text-center mb-16">
          <h2 class="text-sm font-bold text-[#C19A6B] tracking-widest uppercase mb-2">Conócenos</h2>
          <h3 class="text-3xl md:text-4xl font-extrabold text-white mb-8">Quiénes Somos</h3>
          
          <div class="space-y-6 text-lg leading-relaxed text-[#e8dccb] font-medium">
            <p>
              En Saberes, nuestro objetivo es caminar a tu lado en cada etapa de la vida, brindándote un espacio de salud donde te sientas verdaderamente escuchada, protegida y comprendida.
            </p>
            <p>
              Como matronas entendemos que tu bienestar va mucho más allá de una consulta médica; por eso, nos dedicamos a ofrecerte una atención profundamente empática, cálida y profesional.
            </p>
            <p>
              Queremos que dejes atrás las dudas o los temores y que encuentres en nosotras un apoyo cercano y transparente para cuidar de tu salud sexual y reproductiva.
            </p>
          </div>
        </div>

        <!-- Tarjetas Individuales del Equipo -->
        <div class="grid lg:grid-cols-2 gap-8">
          
          <!-- Perfil Javiera -->
          <div class="bg-[#faf8f5] p-8 rounded-3xl shadow-lg border-t-4 border-[#C19A6B] flex flex-col md:flex-row gap-8 items-center md:items-start text-center md:text-left text-slate-700 hover:shadow-xl transition-shadow">
            <img src="/javiera-perfil.jpg" alt="Matrona Javiera Silva" class="w-40 h-40 md:w-48 md:h-48 rounded-full object-cover object-center border-4 border-white shadow-md shrink-0" />
            <div class="flex-grow">
              <h4 class="text-2xl font-bold text-[#314832] mb-1">Javiera Silva</h4>
              <p class="text-[#C19A6B] font-bold text-sm uppercase tracking-wide mb-4">Matrona</p>
              
              <p class="text-sm leading-relaxed text-slate-600 mb-4">
                ¡Hola! Soy Javiera, matrona y cofundadora de Saberes. Desde que elegí este camino, mi gran motivación ha sido derribar las barreras del miedo y la desinformación en la salud de las mujeres. Para mí, cada consulta es una oportunidad de entregarte un espacio seguro, donde no existan tabúes y te sientas con la total libertad de preguntar lo que necesites. Me apasiona acompañarte de manera cercana, transparente y con base científica, asegurándome de que te vayas a casa sintiéndote empoderada, escuchada y dueña de tus propias decisiones de salud. Estoy aquí para cuidarte y guiarte con todo el cariño que te mereces.
              </p>
              
              <h5 class="text-sm font-bold text-[#314832] mb-2">Mi formación y especialidades:</h5>
              <ul class="text-sm text-slate-600 space-y-1 text-left inline-block md:block">
                <li>✔️ Matrona</li>
                <li>✔️ Magíster en Salud Sexual y Reproductiva</li>
                <li>✔️ Consejera de Lactancia Materna</li>
                <li>✔️ (C) Diplomada en Sexología Clínica y Educativa</li>
                <li>✔️ Capacitada para procedimientos de Plasmapen</li>
              </ul>
            </div>
          </div>

          <!-- Perfil Valentina -->
          <div class="bg-[#faf8f5] p-8 rounded-3xl shadow-lg border-t-4 border-[#C19A6B] flex flex-col md:flex-row gap-8 items-center md:items-start text-center md:text-left text-slate-700 hover:shadow-xl transition-shadow">
            <!-- RECUERDA VERIFICAR EL NOMBRE Y EXTENSIÓN DE ESTA IMAGEN -->
            <img src="/foto-valentina.jpg" alt="Matrona Valentina Leal" class="w-40 h-40 md:w-48 md:h-48 rounded-full object-cover object-center border-4 border-white shadow-md shrink-0" />
            <div class="flex-grow">
              <h4 class="text-2xl font-bold text-[#314832] mb-1">Valentina Leal</h4>
              <p class="text-[#C19A6B] font-bold text-sm uppercase tracking-wide mb-4">Matrona</p>
              
              <p class="text-sm leading-relaxed text-slate-600 mb-4">
                ¡Hola! Mi nombre es Valentina y soy matrona en este hermoso espacio llamado Saberes. Mi propósito de vida es resignificar la atención de matronería, transformándola en una experiencia cálida, humana y profundamente respetuosa. Creo firmemente que cada etapa que vives merece ser acompañada con contención, empatía y mucha dulzura.
              </p>
              
              <h5 class="text-sm font-bold text-[#314832] mb-2">Mi formación y especialidades:</h5>
              <ul class="text-sm text-slate-600 space-y-1 text-left inline-block md:block">
                <li>✔️ Matrona y Madre</li>
                <li>✔️ (C) Magíster en Dirección Estratégica en Salud</li>
                <li>✔️ Consejera de Lactancia y Especialista en Destete</li>
                <li>✔️ Capacitada para inserción de implantes subdérmicos y dispositivos intrauterinos (DIU)</li>
              </ul>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- SECCIÓN DE SERVICIOS -->
    <section id="servicios" class="py-20 bg-[#faf8f5] px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-extrabold text-center text-[#314832] mb-12">Nuestros Servicios</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {[
            { titulo: "Control Ginecológico", desc: "Atención integral personalizada para cada etapa de tu vida." },
            { titulo: "Salud Reproductiva", desc: "Gestión de dispositivos (DIU) e implantes con técnica segura." },
            { titulo: "Anticoncepción", desc: "Orientación y administración de métodos inyectables." },
            { titulo: "Atención Online", desc: "Consulta remota cómoda y accesible para tus dudas." },
            { titulo: "Exámenes y Paneles", desc: "Toma de PAP, PCR VPH y paneles especializados." },
            { titulo: "Estética (Plasmapen)", desc: "Procedimientos de regeneración cutánea profesional." },
            { titulo: "Control de Embarazo", desc: "Acompañamiento cálido durante tu gestación." },
            { titulo: "Recambios", desc: "Actualización de dispositivos intrauterinos e implantes." }
          ].map((servicio) => (
            <div class="group bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:border-[#C19A6B] hover:shadow-xl transition-all duration-300">
              <div class="w-12 h-1 bg-[#C19A6B] mb-6 rounded-full group-hover:w-20 transition-all"></div>
              <h3 class="text-xl font-bold text-[#314832] mb-3">{servicio.titulo}</h3>
              <p class="text-slate-600 leading-relaxed text-sm">{servicio.desc}</p>
            </div>
          ))}
</div>
      </div>
    </section>

    <!-- SECCIÓN UBICACIÓN Y CONTACTO -->
    <section id="ubicacion" class="flex-grow py-20 bg-white px-6">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row gap-12">
        
        <div class="w-full md:w-3/5 rounded-2xl overflow-hidden shadow-md border border-slate-200">
          <iframe 
            src="https://maps.google.com/maps?q=O%27Higgins%20Poniente%2077%2C%20Concepci%C3%B3n%2C%20Chile&t=&z=16&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            class="min-h-[350px]"
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>

        <div class="w-full md:w-2/5 flex flex-col justify-center">
          <h2 class="text-3xl font-extrabold text-[#314832] mb-6">Hablemos</h2>
          <p class="text-slate-600 mb-6">Contacto y detalles:</p>
          
          <div class="space-y-4 mb-8">
            <p class="flex items-start gap-3 text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C19A6B] shrink-0" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /><path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" /></svg>
              <span>O'Higgins Poniente 77<br/>Edificio Futuro Center, Of. 804<br/>Concepción</span>
            </p>
            <p class="flex items-center gap-3 text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C19A6B] shrink-0" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" /></svg>
              <span>+569 54365775</span>
            </p>
            <p class="flex items-center gap-3 text-slate-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[#C19A6B] shrink-0" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" /><path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M16.5 7.5l0 .01" /></svg>
              <span><a href="https://instagram.com/saberes.cl" target="_blank" class="hover:text-[#C19A6B] transition-colors">@saberes.cl</a></span>
            </p>
          </div>

          <a 
            href="https://wa.me/56954365775?text=Hola,%20quisiera%20saber%20más%20sobre%20la%20ubicación%20y%20horas%20disponibles." 
            target="_blank" 
            class="inline-flex bg-[#314832] text-white px-6 py-3 rounded-full font-bold shadow-md hover:bg-[#233524] transition-all gap-2 justify-center items-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"></path></svg>
            Agendar por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#233524] py-8 text-center text-[#e8dccb]">
      <p class="text-sm">© 2026 Centro Médico Saberes. Matronas Javiera Silva y Valentina Leal.</p>
      <p class="text-xs mt-2 opacity-70">"Contigo en cada etapa"</p>
    </footer>

  </body>
</html>