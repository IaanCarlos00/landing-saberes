              <ul class="text-sm text-slate-600 space-y-1 text-left inline-block md:block">
                <li>✔️ Matrona y Madre</li>
                <li>✔️ (C) Magíster en Dirección Estratégica en Salud</li>
                <li>✔️ Consejera de Lactancia y Especialista en Destete</li>
                <li>✔️ Capacitada para inserción de implantes subdérmicos y dispositivos intrauterinos (DIU)</li>
              </ul>
            <div class="text-left bg-white p-4 rounded-xl border border-slate-200">
            <h6 class="font-bold text-[#314832] text-sm mb-2">Horarios matrona Valentina</h6>
            <ul class="text-xs text-slate-600 space-y-1">
              <li>Lunes 08:30 - 15:30</li>
              <li>Martes, Jueves y Viernes 08:30 - 13:30</li>
              <li>Miércoles 08:30 - 11:30</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
