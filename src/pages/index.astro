            <div class="w-full sm:w-[48%] lg:w-[31%] bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:border-[#C19A6B] hover:shadow-lg transition-all duration-300 flex flex-col">
              <div class="w-12 h-1 bg-[#C19A6B] mb-6 rounded-full"></div>
              <h3 class="text-xl font-bold text-[#314832] mb-3">{servicio.titulo}</h3>
              <p class="text-slate-600 text-sm mb-4 font-medium">{servicio.desc}</p>
              <ul class="text-sm text-slate-600 space-y-3 flex-grow">
                {servicio.items.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="text-[#C19A6B] mt-0.5 font-bold">✓</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

