---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import Header      from '../components/Header.astro';
import Hero        from '../components/Hero.astro';
import StatsBar    from '../components/StatsBar.astro';
import Equipo      from '../components/Equipo.astro';
import Servicios   from '../components/Servicios.astro';
import Convenios   from '../components/Convenios.astro';
import Educacion   from '../components/Educacion.astro';
import Calculadora from '../components/Calculadora.astro';
import Ubicacion   from '../components/Ubicacion.astro';
import FAQ         from '../components/FAQ.astro';
import Resenas     from '../components/Resenas.astro';
import Footer      from '../components/Footer.astro';
import ConveniosModal from '../components/ConveniosModal.astro';
---

<html lang="es" class="scroll-smooth">
  <head>
    <link rel="icon" type="image/png" href="/logofinal.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Saberes: Matronas en Concepción especializadas en salud integral femenina, anticoncepción, embarazo y más. Reserva tu hora aquí.">
    <meta name="keywords" content="Matronas Concepción, Saberes, Salud femenina Concepción, Anticonceptivos Concepción, PAP Concepción">
    <link rel="canonical" href="https://www.saberes.cl">
    <title>Saberes - Matronas en Concepción</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "name": "Saberes - Matronas en Concepción",
      "image": "https://www.saberes.cl/logofinal.png",
      "url": "https://www.saberes.cl",
      "telephone": "+56954365775",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "O'Higgins Poniente 77, Edificio Futuro Center, Of. 804",
        "addressLocality": "Concepción",
        "addressRegion": "Biobío",
        "addressCountry": "CL"
      },
      "sameAs": [
        "https://www.instagram.com/saberes.cl",
        "https://www.tiktok.com/@javierasilvacatalan"
      ]
    })} />
  </head>

  <body>
    <!-- Floating WhatsApp button -->
    <a
      href="https://wa.me/56954365775?text=Hola,%20vengo%20desde%20la%20página%20web%20y%20me%20gustaría%20agendar%20una%20cita."
      target="_blank" rel="noopener noreferrer"
      class="wa-float"
      aria-label="Contactar por WhatsApp"
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <Header />
    <Hero />
    <StatsBar />
    <Equipo />
    <Servicios />
    <Convenios />
    <Educacion />
    <Calculadora />
    <Ubicacion />
    <FAQ />
    <Resenas />
    <Footer />
    <CookieConsent />
    <ConveniosModal />
  </body>

  <script is:inline>
    // Scroll reveal — global, shared across all components
    const revealEls = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(el => revealObserver.observe(el));
  </script>
</html>