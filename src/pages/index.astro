<!-- Banner de Cookies Profesional -->
<div id="cookie-consent" class="fixed bottom-6 right-6 max-w-sm bg-white p-6 rounded-3xl shadow-2xl border border-slate-100 z-50 translate-y-20 opacity-0 transition-all duration-700">
  <h4 class="font-bold text-[#314832] mb-2">Política de Privacidad</h4>
  <p class="text-sm text-slate-600 mb-4 leading-relaxed">
    En Saberes, protegemos tus datos personales conforme a la normativa vigente. Utilizamos cookies propias para el funcionamiento básico del sitio. 
    <a href="/privacidad" class="underline text-[#C19A6B]">Ver detalle</a>.
  </p>
  <div class="flex gap-3">
    <button id="btn-reject" class="flex-1 px-4 py-2 text-sm text-slate-500 hover:text-slate-800 transition">Rechazar</button>
    <button id="btn-accept" class="flex-1 px-4 py-2 text-sm bg-[#314832] text-white rounded-xl hover:bg-[#233524] transition">Aceptar</button>
  </div>
</div>

<script is:inline>
  const banner = document.getElementById('cookie-consent');
  
  // Mostrar si no ha interactuado
  if (!localStorage.getItem('consentimiento')) {
    setTimeout(() => {
      banner.classList.remove('translate-y-20', 'opacity-0');
    }, 1000);
  }

  // Lógica de aceptación
  document.getElementById('btn-accept').addEventListener('click', () => {
    localStorage.setItem('consentimiento', 'true');
    banner.classList.add('opacity-0', 'translate-y-20');
    // AQUÍ PUEDES CARGAR SCRIPTS DE ANALYTICS O TERCEROS
    console.log("Cookies aceptadas, cargando servicios...");
  });

  // Lógica de rechazo
  document.getElementById('btn-reject').addEventListener('click', () => {
    localStorage.setItem('consentimiento', 'false');
    banner.classList.add('opacity-0', 'translate-y-20');
  });
</script>


<script is:inline>
  function update() {
    let total = 0;
    let items = [];
    document.querySelectorAll('#calculadora input[type="checkbox"]:checked').forEach(c => {
      total += parseInt(c.value);
      items.push(c.dataset.name);
    });
    
    document.getElementById('total-precio').innerText = total.toLocaleString('es-CL');
    
    const btn = document.getElementById('btn-wsp');
    const msg = items.length > 0 
      ? `Hola, me gustaría agendar:\n${items.map(i => '- ' + i).join('\n')}\n\nTotal estimado: $${total.toLocaleString('es-CL')}`
      : "Hola, me gustaría agendar una consulta.";
    btn.href = "https://wa.me/56954365775?text=" + encodeURIComponent(msg);
  }

  document.querySelectorAll('#calculadora input').forEach(cb => cb.addEventListener('change', update));
</script>

