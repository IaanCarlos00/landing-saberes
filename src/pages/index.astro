---
import '../global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Centro Médico Saberes: Matronas en Concepción especializadas en salud integral femenina, anticoncepción, embarazo y más. Reserva tu hora aquí.">
    <meta name="keywords" content="Matronas Concepción, Centro Médico Saberes, Salud femenina Concepción, Anticonceptivos Concepción, PAP Concepción">
    <link rel="canonical" href="https://www.saberes.cl">
    <title>Centro Médico Saberes - Matronas en Concepción</title>
  </head>
  <body class="bg-white text-slate-700 font-sans antialiased flex flex-col min-h-screen">
    
    <!-- HEADER / BARRA DE NAVEGACIÓN -->
    <header class="flex justify-between items-center py-4 px-6 md:px-12 bg-white border-b border-slate-100 sticky top-0 z-50 shadow-sm">
      <div class="flex items-center gap-3">
        <img src="/logofinal.png" alt="Logo Saberes" class="h-10 w-auto" />
        <div class="hidden sm:block leading-tight">
          <h1 class="font-bold text-[#314832] text-lg">Saberes</h1>
