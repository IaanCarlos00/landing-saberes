---
// Servicios.astro
const servicios = [
  {
    icono: "🏥",
    titulo: "Atención Clínica",
    desc: "Control Ginecológico · Anticonceptiva · Preconcepcional · Prenatal",
    items: [
      "Fonasa: $5.700",
      "Particular: $20.000",
      "Estudiantes: $12.000 (con credencial)",
    ],
  },
  {
    icono: "💻",
    titulo: "Telemedicina y Lactancia",
    desc: "Acompañamiento técnico y amoroso a tu medida, donde estés:",
    items: [
      "Atención Online (Chat WhatsApp): $10.000",
      "Consejería Lactancia en Box: $35.000",
      "Consejería Lactancia a Domicilio: $45.000",
    ],
  },
  {
    icono: "🔬",
    titulo: "Toma de Muestras Clínicas",
    desc: "Procedimientos delicados y respetuosos:",
    items: [
      "Papanicolau (PAP con lab): $17.000",
      "Genotipificación VPH (con lab): $75.000",
      "Panel ITS: desde $5.000",
      "Flujo Vaginal: desde $5.000",
    ],
  },
  {
    icono: "💉",
    titulo: "Anticonceptivos Inyectables",
    desc: "Administración segura bajo normas clínicas:",
    items: [
      "Sayana Press (incluye medicamento): $22.000",
      "Mesigyna (incluye medicamento): $12.000",
      "Administración (traes receta y ampolla): $5.000",
    ],
  },
  {
    icono: "🔷",
    titulo: "Dispositivos Larga Duración",
    desc: "Colocación profesional y seguimiento cercano:",
    items: [
      "T de Cobre: Inserción $55.000 / Retiro $35.000",
      "Implanon: Inserción $110.000",
      "Asertia (DIU Hormonal): Inserción $120.000",
    ],
  },
  {
    icono: "✨",
    titulo: "Estética y Lesiones Genitales",
    desc: "Técnica novedosa de Plasmapen (Valor base: $40.000):",
    items: [
      "Extracción segura con anestesia local",
      "Verrugas genitales, moluscos y condilomas",
      "Acrocordones",
    ],
  },
];
---

<section id="servicios" class="servicios-section">
  <div class="servicios-header reveal">
    <span class="section-label">Lo que ofrecemos</span>
    <h2>Nuestros Servicios</h2>
    <p>Atención integral con los más altos estándares clínicos, en un espacio cálido y sin juicios.</p>
  </div>

  <div class="servicios-grid">
    {servicios.map((s, i) => (
      <div class={`servicio-card reveal reveal-delay-${(i % 3) + 1}`}>
        <div class="servicio-icon">{s.icono}</div>
        <h3>{s.titulo}</h3>
        <p class="desc">{s.desc}</p>
        <ul>
          {s.items.map(item => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
