            </svg>
          </a>
        </div>
      </div>

      {/* LINKS */}
      <div class="footer-section">
        <h4>Servicios</h4>
        <ul>
          <li><a href="/#servicios">Nuestros Servicios</a></li>
          <li><a href="/#equipo">Conoce al Equipo</a></li>
          <li><a href="/#ubicacion">Ubicación</a></li>
          <li><a href="/#preguntas">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      {/* LEGAL */}
      <div class="footer-section">
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacidad">Política de Privacidad</a></li>
          <li><a href="/cookies">Política de Cookies</a></li>
          <li><a href="/terminos">Términos y Condiciones</a></li>
        </ul>
      </div>

      {/* CONTACTO + CONVENIOS */}
      <div class="footer-section">
        <h4>Contacto</h4>
        <ul>
          <li><a href="https://wa.me/56954365775" target="_blank">WhatsApp</a></li>
          <li><a href="mailto:saberesspa@gmail.com">Email</a></li>
          <li>
            <button 
              onclick="abrirConveniosModal()" 
              class="footer-convenios-btn"
            >
              Convenios Corporativos
            </button>
          </li>
        </ul>
      </div>
    </div>

    {/* COPYRIGHT */}
    <div class="footer-bottom">
      <p>&copy; 2026 Centro Médico Saberes. Todos los derechos reservados.</p>
      <p>O'Higgins Poniente 77, Edificio Futuro Center, Of. 804, Concepción</p>
    </div>
  </div>
</footer>

{/* MODAL */}
<ConveniosModal />

<style>
  .footer {
    background: linear-gradient(180deg, #233524 0%, #1a2819 100%);
    color: #e8dccb;
    padding: 60px 40px 20px;
    margin-top: 80px;
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
    margin-bottom: 40px;
  }

  .footer-brand {
    grid-column: 1;
  }

  .footer-logo {
    height: 40px;
    width: auto;
    margin-bottom: 16px;
  }

  .footer-section p {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(232, 220, 203, 0.8);
    margin-bottom: 16px;
  }

  .footer-section h4 {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--dorado);
    margin-bottom: 16px;
  }

  .footer-section ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-section a,
  .footer-convenios-btn {
    font-size: 13px;
    color: rgba(232, 220, 203, 0.8);
    text-decoration: none;
    transition: all 0.3s ease;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
  }

  .footer-section a:hover,
  .footer-convenios-btn:hover {
    color: var(--dorado);
  }

  /* SOCIALS */
  .footer-socials {
    display: flex;
    gap: 16px;
  }

  .footer-socials a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(193, 154, 107, 0.15);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .footer-socials a:hover {
    background: rgba(193, 154, 107, 0.3);
    transform: translateY(-2px);
  }

  /* BOTTOM */
  .footer-bottom {
    border-top: 1px solid rgba(193, 154, 107, 0.2);
    padding-top: 20px;
    text-align: center;
    font-size: 12px;
    color: rgba(232, 220, 203, 0.6);
  }

  .footer-bottom p {
    margin: 4px 0;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .footer {
      padding: 40px 24px 20px;
    }

    .footer-container {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 24px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-section h4 {
      font-size: 12px;
    }
  }
</style>