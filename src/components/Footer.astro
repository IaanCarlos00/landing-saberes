---
// Footer.astro - Actualizado con saberesspa@gmail.com
import ConveniosModal from './ConveniosModal.astro';
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-container">
      {/* LOGO Y DESC */}
      <div class="footer-section footer-brand">
        <img src="/logofinal.png" alt="Saberes" class="footer-logo" />
        <p>Centro Médico Saberes: Matronería integral, cálida y sin tabúes.</p>
        <div class="footer-socials">
          <a href="https://www.instagram.com/saberes.cl" target="_blank" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@javierasilvacatalan" target="_blank" aria-label="TikTok">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.08 1.61 2.88 2.88 0 0 1 4.07-4.77v-3.4a6.47 6.47 0 0 0-6.64 6.61 6.40 6.40 0 0 0 9.01-5.9 6.65 6.65 0 0 0-.78-3.15Z"></path>
            </svg>
          </a>
