---
// Resenas.astro
---

<section class="resenas-section">
  <div class="resenas-header reveal">
    <span class="section-label">Lo que dicen nuestras pacientes</span>
    <h2>Reseñas</h2>
    <p>Experiencias reales de quienes ya nos conocen.</p>
  </div>

  <div class="resenas-track-wrapper">
    <div class="resenas-track" id="resenasTrack">
      <p class="resenas-estado">Cargando reseñas...</p>
    </div>
  </div>
</section>

<style>
  .resenas-section {
    background: var(--crema-dark);
    padding: 100px 0;
    overflow: hidden;
  }

  .resenas-header {
    text-align: center;
    padding: 0 24px;
    margin-bottom: 56px;
  }
  .resenas-header h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--verde-dark);
    margin-bottom: 12px;
  }
  .resenas-header p {
    color: var(--texto-soft);
    font-size: 1.05rem;
  }

  .resenas-track-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .resenas-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 24px;
    width: max-content;
    padding: 20px 40px;
    align-items: stretch;
  }

  .resenas-track.animando {
    animation: scrollTrack 30s linear infinite;
  }
  .resenas-track.animando:hover {
    animation-play-state: paused;
  }

  @keyframes scrollTrack {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .resena-card {
    background: #ffffff !important;
    border-radius: 20px !important;
    padding: 28px 28px !important;
    width: 300px !important;
    min-width: 300px !important;
    max-width: 300px !important;
    height: 210px !important;
    flex-shrink: 0 !important;
    box-shadow: 0 4px 20px rgba(49, 72, 50, 0.10) !important;
    border: 1px solid rgba(193, 154, 107, 0.20) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
    cursor: default;
    box-sizing: border-box !important;
    overflow: hidden !important;
  }

  .resena-card:hover {
    box-shadow: 0 8px 32px rgba(49, 72, 50, 0.18) !important;
  }

  .resena-estrellas {
    display: flex;
    gap: 3px;
    flex-shrink: 0;
  }

  .estrella      { font-size: 1rem; color: var(--dorado, #c19a6b); }
  .estrella.vacia { color: #ddd; }

  .resena-texto {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--texto, #2d2d2d);
    flex: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    margin: 0;
  }

  .resena-nombre {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--verde, #314832);
    letter-spacing: 0.03em;
    flex-shrink: 0;
    margin: 0;
  }

  .resenas-estado {
    text-align: center;
    padding: 48px 24px;
    color: var(--texto-soft);
    font-size: 0.95rem;
    width: 100%;
  }
</style>

<script is:inline>
  const ENCUESTAS_URL = 'https://centro-medico-saberes-production.up.railway.app/encuestas';

  async function cargarResenas() {
    const track = document.getElementById('resenasTrack');
    if (!track) return;

    let resenas = [];

    try {
      const res = await fetch(ENCUESTAS_URL);
      if (!res.ok) throw new Error('Error de red');
      const todas = await res.json();

      resenas = todas.filter(e =>
        e.estado === 'respondida' &&
        e.comentario &&
        e.comentario.trim() !== '' &&
        e.estrellas
      );
    } catch (e) {
      track.innerHTML = '';
      return;
    }

    if (!resenas.length) {
      track.innerHTML = '';
      return;
    }

    function nombreAnonimo(nombre, apellido) {
      const n = (nombre || '').trim().split(' ')[0];
      const a = (apellido || '').trim()[0];
      return a ? `${n} ${a}.` : n;
    }

    function tarjetaHTML(r) {
      const pts = Math.max(1, Math.min(5, Math.round(r.estrellas)));
      const estrellas = Array.from({ length: 5 }, (_, i) =>
        `<span class="estrella${i < pts ? '' : ' vacia'}">★</span>`
      ).join('');
      const nombre = nombreAnonimo(r.paciente_nombre, r.paciente_apellido);
      const comentario = r.comentario.length > 150
        ? r.comentario.slice(0, 147) + '…'
        : r.comentario;
      return `
        <div class="resena-card">
          <div class="resena-estrellas">${estrellas}</div>
          <p class="resena-texto">${comentario}</p>
          <span class="resena-nombre">— ${nombre}</span>
        </div>
      `;
    }

    // Triplicamos si hay pocas reseñas para que el carrusel llene bien
    const copias = resenas.length < 4 ? [...resenas, ...resenas, ...resenas, ...resenas] : [...resenas, ...resenas];
    const html = copias.map(tarjetaHTML).join('');
    track.innerHTML = html;
    track.classList.add('animando');
  }

  cargarResenas();
</script>