---
// Hero.astro
const WA_URL = "https://wa.me/56954365775?text=Hola,%20vengo%20desde%20la%20página%20web%20y%20me%20gustaría%20agendar%20una%20cita.";
---

<section class="hero">
  <div class="hero-bg-orbs">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>

  <div class="hero-content">
    <span class="hero-eyebrow">Matronería Integral · Concepción</span>

    <h1 class="hero-title font-display">
      Tu salud, en manos <em>profesionales</em> y empáticas.
    </h1>

    <p class="hero-sub">
      Espacio de atención integral para la mujer en Concepción y online a todo Chile.
      Cuidado cálido, honesto y sin tabúes.
    </p>

    <div class="hero-actions">
      <a href={WA_URL} target="_blank" class="btn-primary btn-wa-pulse">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#C19A6B">
          <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9l-5.05.9"/>
          <path d="M9 10a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>
        </svg>
        Agendar por WhatsApp
      </a>
      <a href="#servicios" class="btn-secondary">Ver Servicios →</a>
    </div>
  </div>

  <div class="hero-image">
    <div class="hero-image-wrapper">
      <img src="/foto-equipo.jpg" alt="Matronas Javiera y Valentina de Saberes" loading="eager" />

      <div class="hero-badge">
        <div class="hero-badge-icon">🌿</div>
        <div class="hero-badge-text">
          <strong>Atención Fonasa</strong>
          <span>Desde $5.700</span>
        </div>
      </div>

      <div class="hero-badge-2">
        <div>
          <strong>Online a todo Chile</strong>
          <span>Telemedicina disponible</span>
        </div>
      </div>
    </div>
  </div>
</section>
